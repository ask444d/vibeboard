{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for VibeBoard desktop: pick folders, read project files, open paths in system apps.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-stat", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$HOME/**" }] },
    "shell:allow-open",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "sql:default",
    "sql:allow-execute"
  ]
}
