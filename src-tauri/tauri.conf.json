{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "VibeBoard", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["../public/favicon.svg"] },
  "plugins": {
    "sql": { "preload": ["sqlite:vibeboard.db"] },
    "shell": { "open": true },
    "fs": { "scope": ["$HOME/**", "$PROJECT/**"] },
    "opener": {}
  }
}
